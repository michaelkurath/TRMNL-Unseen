{% capture unseen_setup %}
<div class="unseen__setup flex flex--col flex--top flex--stretch-x gap--small w--full h--full p--6">
  <span class="title lg:title--large">Unseen</span>
  <span class="description lg:description--large">Add the public collection URL in plugin settings to load today's micrograph.</span>
</div>
{% endcapture %}
{% capture unseen_image %}
<div class="unseen__image grow relative bg--black w--full">
  <img class="image image-dither image--contain absolute top--0 left--0 w--full h--full" src="{{ selected_entry.image_url | escape }}" alt="{{ selected_entry.title | escape }} — scanning electron micrograph">
</div>
{% endcapture %}
{% capture unseen_subject %}
<span class="unseen__subject title lg:title--large">{{ selected_entry.title | escape }}</span>
{% if selected_entry.magnification != blank %}<span class="description lg:description--large">{{ selected_entry.magnification | escape }} capture</span>{% endif %}
{% endcapture %}
{% capture unseen_details %}
<div class="description lg:description--large">Scanning electron micrograph</div>
<div class="description lg:description--large">{{ display_date }}</div>
{% endcapture %}
{% capture unseen_credit %}
<div class="unseen__credit shrink-0 px--3 py--2 lg:px--4 border--h-10">
  <span class="unseen__rights description lg:description--large"><a class="text--black" href="{{ selected_entry.source_page | escape }}">{{ selected_entry.credit | escape }}</a> · <a class="text--black" href="{{ selected_entry.license_url | escape }}">{{ selected_entry.license | escape }}</a> · adapted</span>
</div>
{% endcapture %}
{% capture unseen_titlebar %}
<div class="title_bar">
  <span class="title">Unseen</span>
  {% unless setup_required %}<span class="instance">Plate {{ plate_number }}</span>{% endunless %}
</div>
{% endcapture %}
